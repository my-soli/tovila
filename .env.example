# Which WhatsApp integration to use: "meta" (direct Cloud API, default) or
# "twilio" (Twilio's WhatsApp API, routed through their sandbox/number —
# useful while Meta business verification is pending). See
# src/whatsapp/client.js for the dispatcher this switches.
WHATSAPP_PROVIDER=meta

# WhatsApp Business Cloud API (Meta for Developers) — used when
# WHATSAPP_PROVIDER=meta (or unset).
WHATSAPP_ACCESS_TOKEN=your_meta_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_test_number_phone_number_id
# Any random string you choose yourself — you'll enter this same value in the
# Meta App Dashboard webhook config. It just proves the callback is really you.
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
# App secret from Meta App Dashboard -> Settings -> Basic. Used to verify
# X-Hub-Signature-256 on incoming webhook POSTs, rejecting anything that
# isn't genuinely from Meta before any processing happens.
WHATSAPP_APP_SECRET=your_meta_app_secret
# Set to false to skip signature verification (e.g. local testing before
# WHATSAPP_APP_SECRET is set — scripts/simulate-message.js signs its
# requests for real when the secret IS set, so this is just a fallback).
VERIFY_WEBHOOK_SIGNATURE=true

# Twilio WhatsApp API — used when WHATSAPP_PROVIDER=twilio. Find these in
# the Twilio Console: Account SID + Auth Token on the dashboard homepage,
# the sandbox number under Messaging -> Try it out -> Send a WhatsApp
# message (no leading "+", e.g. 14155238886).
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=14155238886
# Set to your exact public callback URL (e.g. the ngrok https URL +
# "/webhook") if signature verification fails behind a tunnel/proxy — Twilio
# signs the URL it thinks it called, which can differ from what Express sees
# through a forwarding layer.
# TWILIO_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/webhook

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# Claude model used for the agent's replies. claude-opus-4-8 is the most
# capable; swap to claude-sonnet-5 for lower latency/cost on a chat bot.
CLAUDE_MODEL=claude-opus-4-8

# Database (matches docker-compose.yml defaults)
# DATABASE_URL=postgresql://tovila:tovila@localhost:5432/tovila
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.qmetppbapwnzvsuyauqt:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.qmetppbapwnzvsuyauqt:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Server
PORT=3000

# Dashboard (Phase 2) — single hardcoded login shown during seller demos.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose_a_demo_password
# Signs the dashboard's login session cookie (Phase 6). Any long random
# string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Changing it invalidates all existing logins.
SESSION_SECRET=choose_a_long_random_string

# Optional: sends an email (in addition to the always-on DB notification +
# console log) when a conversation is flagged needs_attention. Leave unset
# to skip email entirely — nothing else depends on this being configured.
# RESEND_API_KEY=your_resend_api_key
