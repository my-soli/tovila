<%- include('partials/header') %>

<h1>Stats</h1>
<p class="hint"><%= currentSeller.name %></p>

<section class="editor-section" style="margin-bottom: var(--sp-6);">
  <div class="section-header">
    <div class="section-icon icon-primary">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M4 5h16v11H9l-4 4V5Z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/></svg>
    </div>
    <h2>Conversations &amp; response time</h2>
  </div>

  <div class="stats-grid" style="margin-bottom: var(--sp-6);">
    <div class="stat-tile">
      <div class="stat-value"><%= stats.totalConversations %></div>
      <div class="stat-label">Total conversations</div>
    </div>
    <div class="stat-tile">
      <div class="stat-value">
        <% if (stats.avgResponseTimeSeconds === null) { %>
          &mdash;
        <% } else if (stats.avgResponseTimeSeconds < 60) { %>
          <%= stats.avgResponseTimeSeconds %>s
        <% } else { %>
          <%= Math.round(stats.avgResponseTimeSeconds / 60) %>m
        <% } %>
      </div>
      <div class="stat-label">Avg. response time</div>
    </div>
    <div class="stat-tile">
      <div class="stat-value"><%= stats.messagesThisWeek %></div>
      <div class="stat-label">Messages this week</div>
    </div>
    <div class="stat-tile">
      <div class="stat-value"><%= stats.messagesThisMonth %></div>
      <div class="stat-label">Messages this month</div>
    </div>
  </div>

  <h3 class="subsection-title">Activity — last 7 days</h3>
  <%- include('partials/activity-chart', { messagesByDay: stats.messagesByDay }) %>
</section>

<section class="editor-section">
  <div class="section-header">
    <div class="section-icon icon-accent">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><rect x="5" y="4" width="14" height="17" rx="2" stroke="#fff" stroke-width="2"/><path d="M9 3h6v3H9V3Z" fill="#fff"/><path d="M8.5 12.5l2 2 4-4.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <h2>Orders &amp; payments</h2>
  </div>

  <div class="stats-grid" style="margin-bottom: var(--sp-6); grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
    <div class="stat-tile">
      <div class="stat-value"><%= stats.totalLeads %></div>
      <div class="stat-label">Orders captured</div>
    </div>
  </div>

  <h3 class="subsection-title">By status</h3>
  <%- include('partials/orders-chart', { ordersByStatus: stats.ordersByStatus, paidCount: stats.paidCount, unpaidCount: stats.unpaidCount }) %>
</section>

<%- include('partials/footer') %>
