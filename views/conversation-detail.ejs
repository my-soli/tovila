<%- include('partials/header') %>

<p><a href="/conversations?sellerId=<%= conversation.seller.id %>">&larr; Back to conversations</a></p>
<h1><%= conversation.customerPhone %></h1>
<p class="hint">
  <%= conversation.seller.name %> &middot;
  <span class="channel-tag channel-<%= conversation.channel %>"><%= conversation.channel %></span> &middot;
  <span class="status-badge status-<%= conversation.status %>"><%= conversation.status.replace('_', ' ') %></span> &middot;
  <span class="window-badge <%= withinWindow ? 'window-open' : 'window-closed' %>">
    <%= withinWindow ? 'Within 24h window' : 'Outside 24h window — template required' %>
  </span>
</p>

<% if (conversation.status === 'needs_attention') { %>
  <form method="POST" action="/conversations/<%= conversation.id %>/resolve" class="resolve-form">
    <button type="submit">Mark resolved</button>
  </form>
<% } %>

<div class="thread">
  <% conversation.messages.forEach(m => { %>
    <div class="bubble <%= m.sender === 'customer' ? 'from-customer' : 'from-agent' %>">
      <div class="bubble-meta">
        <%= m.sender === 'customer' ? 'Customer' : 'Tovila' %> &middot; <%= new Date(m.timestamp).toLocaleString() %>
      </div>
      <div class="bubble-text">
        <% if (m.mediaType) { %><span class="media-badge"><%= m.mediaType %></span> <% } %><%= m.content %>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
