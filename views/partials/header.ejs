<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Tovila Dashboard</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <% const path = typeof currentPath !== 'undefined' ? currentPath : ''; %>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand"><img src="/logo.svg" alt="Tovila" /></div>
      <% if (typeof currentSeller !== 'undefined' && currentSeller) { %>
        <nav class="main-nav">
          <a href="/overview?sellerId=<%= currentSeller.id %>" class="<%= path === '/overview' ? 'active' : '' %>">Overview</a>
          <a href="/conversations?sellerId=<%= currentSeller.id %>" class="<%= path === '/conversations' ? 'active' : '' %>">Conversations</a>
          <a href="/leads?sellerId=<%= currentSeller.id %>" class="<%= path === '/leads' ? 'active' : '' %>">Orders</a>
          <a href="/products?sellerId=<%= currentSeller.id %>" class="<%= path === '/products' ? 'active' : '' %>">Products &amp; FAQs</a>
          <a href="/stats?sellerId=<%= currentSeller.id %>" class="<%= path === '/stats' ? 'active' : '' %>">Stats</a>
        </nav>
      <% } %>
      <div class="sidebar-footer">
        <% if (typeof isAdminSession !== 'undefined' && isAdminSession) { %>
          <label class="seller-switcher-label">
            Viewing
            <select
              class="seller-switcher"
              onchange="const u = new URL(location.href); u.searchParams.set('sellerId', this.value); location.href = u.toString();"
            >
              <% sellers.forEach(s => { %>
                <option value="<%= s.id %>" <%= s.id === currentSeller.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          </label>
          <a href="/onboarding" class="btn-outline <%= path === '/onboarding' ? 'active' : '' %>">+ Add Seller</a>
        <% } else if (typeof currentSeller !== 'undefined' && currentSeller && currentSeller.trialEndsAt) { %>
          <% const daysLeft = Math.ceil((new Date(currentSeller.trialEndsAt) - Date.now()) / (24 * 60 * 60 * 1000)); %>
          <div class="trial-banner <%= daysLeft <= 0 ? 'trial-ended' : '' %>">
            <% if (daysLeft > 0) { %>
              Free trial: <strong><%= daysLeft %></strong> day<%= daysLeft === 1 ? '' : 's' %> left
            <% } else { %>
              Your free trial has ended
            <% } %>
            <a href="/pricing">Upgrade &rarr;</a>
          </div>
        <% } %>
        <a href="/logout" class="logout-link">Log out</a>
      </div>
    </aside>
    <div class="main-area">
      <% if (typeof currentSeller !== 'undefined' && currentSeller && !currentSeller.whatsappNumber) { %>
        <div class="channel-banner">
          Your WhatsApp number isn't connected yet — contact us to finish setup.
        </div>
      <% } %>
      <main class="container">
