<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Tovila Dashboard</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <% const path = typeof currentPath !== 'undefined' ? currentPath : ''; %>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand"><img src="/logo.svg" alt="Tovila" /></div>
      <% if (typeof currentSeller !== 'undefined' && currentSeller) { %>
        <nav class="main-nav">
          <a href="/overview?sellerId=<%= currentSeller.id %>" class="<%= path === '/overview' ? 'active' : '' %>">Overview</a>
          <a href="/conversations?sellerId=<%= currentSeller.id %>" class="<%= path === '/conversations' ? 'active' : '' %>">Conversations</a>
          <a href="/leads?sellerId=<%= currentSeller.id %>" class="<%= path === '/leads' ? 'active' : '' %>">Orders</a>
          <a href="/products?sellerId=<%= currentSeller.id %>" class="<%= path === '/products' ? 'active' : '' %>">Products &amp; FAQs</a>
          <a href="/stats?sellerId=<%= currentSeller.id %>" class="<%= path === '/stats' ? 'active' : '' %>">Stats</a>
        </nav>
      <% } %>
      <div class="sidebar-footer">
        <% if (typeof currentSeller !== 'undefined' && currentSeller && sellers.length > 0) { %>
          <label class="seller-switcher-label">
            Viewing
            <select
              class="seller-switcher"
              onchange="const u = new URL(location.href); u.searchParams.set('sellerId', this.value); location.href = u.toString();"
            >
              <% sellers.forEach(s => { %>
                <option value="<%= s.id %>" <%= s.id === currentSeller.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          </label>
        <% } %>
        <a href="/onboarding" class="btn-outline <%= path === '/onboarding' ? 'active' : '' %>">+ Add Seller</a>
        <a href="/logout" class="logout-link">Log out</a>
      </div>
    </aside>
    <div class="main-area">
      <main class="container">
