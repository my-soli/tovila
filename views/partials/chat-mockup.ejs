<div class="phone-mockup" aria-label="Example conversation with Tovila">
  <div class="phone-notch"></div>
  <div class="phone-header">
    <img src="/logo.svg" alt="" class="phone-header-logo" />
    <div>
      <div class="phone-header-name">Amara Styles</div>
      <div class="phone-header-status">Powered by Tovila</div>
    </div>
  </div>
  <div class="phone-body">
    <div class="phone-bubble from-customer">Hi, do you have the blue wrap dress in size M?</div>
    <div class="phone-bubble from-tovila">Yes! Blue Wrap Dress, size M — KES 2,500. Would you like to order it?</div>
    <div class="phone-bubble from-customer">Yes please, deliver to Kilimani</div>
    <div class="phone-bubble from-tovila">
      Got it — 1x Blue Wrap Dress (M) to Kilimani, KES 2,500 + KES 150 delivery.
      Order recorded, the seller will confirm shortly.
      <span class="phone-bubble-check">&#10003;&#10003;</span>
    </div>
  </div>
</div>
