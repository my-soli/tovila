<%- include('partials/header') %>

<h1>Orders</h1>

<% if (leads.length === 0) { %>
  <p class="empty">No orders captured yet.</p>
<% } else { %>
  <div class="table-scroll">
  <table class="list-table">
    <thead>
      <tr>
        <th>Item</th><th>Qty</th><th>Variant</th><th>Delivery</th>
        <th>Customer</th><th>Phone</th><th>Status</th><th>Paid</th><th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% leads.forEach(l => { %>
        <tr>
          <td><%= l.item %></td>
          <td><%= l.quantity %></td>
          <td><%= l.variant || '—' %></td>
          <td><%= l.deliveryLocation %></td>
          <td><%= l.customerName %></td>
          <td><%= l.conversation.customerPhone %></td>
          <td>
            <form method="POST" action="/leads/<%= l.id %>/status?sellerId=<%= currentSeller.id %>" class="inline-form">
              <select name="status" onchange="this.form.submit()">
                <% ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'].forEach(s => { %>
                  <option value="<%= s %>" <%= s === l.status ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td>
            <form method="POST" action="/leads/<%= l.id %>/paid?sellerId=<%= currentSeller.id %>" class="inline-form">
              <input type="hidden" name="paid" value="<%= l.paid ? 'false' : 'true' %>" />
              <button type="submit" class="paid-toggle <%= l.paid ? 'is-paid' : '' %>">
                <%= l.paid ? 'Paid ✓' : 'Mark paid' %>
              </button>
            </form>
          </td>
          <td class="nowrap"><%= new Date(l.createdAt).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('partials/footer') %>
