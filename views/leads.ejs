<%- include('partials/header') %>

<h1>Leads</h1>

<% if (leads.length === 0) { %>
  <p class="empty">No leads captured yet.</p>
<% } else { %>
  <table class="list-table">
    <thead>
      <tr>
        <th>Item</th><th>Qty</th><th>Variant</th><th>Delivery</th>
        <th>Customer</th><th>Phone</th><th>Status</th><th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% leads.forEach(l => { %>
        <tr>
          <td><%= l.item %></td>
          <td><%= l.quantity %></td>
          <td><%= l.variant || '—' %></td>
          <td><%= l.deliveryLocation %></td>
          <td><%= l.customerName %></td>
          <td><%= l.conversation.customerPhone %></td>
          <td><span class="status-badge"><%= l.status %></span></td>
          <td class="nowrap"><%= new Date(l.createdAt).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
