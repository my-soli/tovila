<%- include('partials/header') %>

<h1>Add a seller</h1>
<p class="hint">Onboard a new seller without touching the database directly. You'll be able to add/edit products and FAQs here too, or refine them later from the Products &amp; FAQs page.</p>

<form method="POST" action="/onboarding" class="editor-form">
  <section class="editor-section">
    <div class="section-header">
      <div class="section-icon icon-primary">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M12 12c2.7 0 4-1.8 4-4s-1.3-4-4-4-4 1.8-4 4 1.3 4 4 4Z" stroke="#fff" stroke-width="2"/><path d="M4 21c0-3.9 3.6-6 8-6s8 2.1 8 6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
      </div>
      <h2>Seller info</h2>
    </div>
    <label>Business name
      <input type="text" name="sellerName" required />
    </label>
    <label>WhatsApp number (the number customers message, no leading "+", e.g. 2547XXXXXXXX)
      <input type="text" name="whatsappNumber" required />
    </label>
    <label>Notification email (for "needs attention" alerts, optional)
      <input type="email" name="sellerNotificationEmail" />
    </label>
    <label>M-Pesa Till Number (optional)
      <input type="text" name="mpesaTillNumber" />
    </label>
  </section>

  <section class="editor-section">
    <div class="section-header">
      <div class="section-icon icon-accent">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M3 11h18M6 11V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4M4 11v8h16v-8" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2>Delivery</h2>
    </div>
    <div class="delivery-grid">
      <label>Nairobi fee (KES)
        <input type="number" name="nairobiFee" value="0" />
      </label>
      <label>Nairobi ETA
        <input type="text" name="nairobiEta" placeholder="e.g. 1-2 days" />
      </label>
      <label>Upcountry fee (KES)
        <input type="number" name="upcountryFee" value="0" />
      </label>
      <label>Upcountry ETA
        <input type="text" name="upcountryEta" placeholder="e.g. 3-5 days" />
      </label>
    </div>
  </section>

  <section class="editor-section">
    <div class="section-header">
      <div class="section-icon icon-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><rect x="5" y="4" width="14" height="17" rx="2" stroke="#fff" stroke-width="2"/><path d="M9 3h6v3H9V3Z" fill="#fff"/></svg>
      </div>
      <h2>Products</h2>
    </div>
    <div id="products-list" class="repeatable-list">
      <div class="repeatable-row">
        <input type="text" name="productName" placeholder="Product name" />
        <input type="number" name="productPrice" placeholder="Price (KES)" />
        <input type="text" name="productSizes" placeholder="Sizes (comma-separated)" />
        <input type="number" name="productStock" placeholder="Stock" />
        <button type="button" class="remove-row-button" aria-label="Remove product">&times;</button>
      </div>
    </div>
    <button type="button" class="add-row-button" data-target="products-list" data-template="product-row-template">+ Add product</button>
    <template id="product-row-template">
      <div class="repeatable-row">
        <input type="text" name="productName" placeholder="Product name" />
        <input type="number" name="productPrice" placeholder="Price (KES)" />
        <input type="text" name="productSizes" placeholder="Sizes (comma-separated)" />
        <input type="number" name="productStock" placeholder="Stock" />
        <button type="button" class="remove-row-button" aria-label="Remove product">&times;</button>
      </div>
    </template>
    <p class="hint">Leave a row's name blank to skip it — you can always add more later.</p>
  </section>

  <section class="editor-section">
    <div class="section-header">
      <div class="section-icon icon-tertiary">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M12 18h.01M9.5 9.5a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 4" stroke="#1C1C1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="#1C1C1E" stroke-width="2"/></svg>
      </div>
      <h2>FAQs</h2>
    </div>
    <div id="faqs-list" class="repeatable-list">
      <div class="repeatable-row repeatable-row-faq">
        <input type="text" name="faqQuestion" placeholder="Question" />
        <input type="text" name="faqAnswer" placeholder="Answer" />
        <button type="button" class="remove-row-button" aria-label="Remove FAQ">&times;</button>
      </div>
    </div>
    <button type="button" class="add-row-button" data-target="faqs-list" data-template="faq-row-template">+ Add FAQ</button>
    <template id="faq-row-template">
      <div class="repeatable-row repeatable-row-faq">
        <input type="text" name="faqQuestion" placeholder="Question" />
        <input type="text" name="faqAnswer" placeholder="Answer" />
        <button type="button" class="remove-row-button" aria-label="Remove FAQ">&times;</button>
      </div>
    </template>
  </section>

  <button type="submit">Add seller</button>
</form>

<%- include('partials/repeatable-rows-script') %>
<%- include('partials/footer') %>
