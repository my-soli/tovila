<%- include('partials/header') %>

<h1>Overview</h1>
<p class="hint"><%= currentSeller.name %></p>

<div class="stats-strip">
  <div class="stat-tile stat-tile-primary">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M4 5h16v11H9l-4 4V5Z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/></svg>
    </div>
    <div class="stat-value"><%= stats.totalConversations %></div>
    <div class="stat-label">Total conversations</div>
  </div>
  <div class="stat-tile stat-tile-accent">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><rect x="5" y="4" width="14" height="17" rx="2" stroke="#fff" stroke-width="2"/><path d="M9 3h6v3H9V3Z" fill="#fff"/></svg>
    </div>
    <div class="stat-value"><%= stats.totalLeads %></div>
    <div class="stat-label">Orders captured</div>
  </div>
  <div class="stat-tile stat-tile-tertiary">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="12" cy="12" r="9" stroke="#1C1C1E" stroke-width="2"/><path d="M12 7v5l3 3" stroke="#1C1C1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="stat-value">
      <% if (stats.avgResponseTimeSeconds === null) { %>
        &mdash;
      <% } else if (stats.avgResponseTimeSeconds < 60) { %>
        <%= stats.avgResponseTimeSeconds %>s
      <% } else { %>
        <%= Math.round(stats.avgResponseTimeSeconds / 60) %>m
      <% } %>
    </div>
    <div class="stat-label">Avg. response time</div>
  </div>
</div>

<h2>Activity — last 7 days</h2>
<div class="chart-card">
  <%- include('partials/activity-chart', { messagesByDay: stats.messagesByDay }) %>
</div>

<div class="overview-columns">
  <div class="attention-card">
    <div class="attention-card-header">
      <div class="section-icon icon-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M12 3 2 20h20L12 3Z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M12 9v5M12 17h.01" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
      </div>
      <h2>Needs your attention</h2>
      <% if (needsAttention.length > 0) { %><span class="action-count"><%= needsAttention.length %></span><% } %>
    </div>
    <% if (needsAttention.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none"><path d="m5 13 4 4L19 7" stroke="#1F7A54" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>All caught up</h3>
        <p>Nothing needs attention right now.</p>
      </div>
    <% } else { %>
      <ul class="action-list">
        <% needsAttention.forEach(c => { %>
          <li>
            <a href="/conversations/<%= c.id %>">
              <span>
                <span class="action-title"><%= c.customerPhone %></span><br />
                <span class="action-meta">
                  <% if (c.lastMessage) { %><%= c.lastMessage.sender === 'agent' ? 'You: ' : '' %><%= c.lastMessage.content %><% } else { %>No messages yet<% } %>
                </span>
              </span>
              <span class="nowrap action-meta"><%= new Date(c.lastActivityAt).toLocaleString() %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="attention-card">
    <div class="attention-card-header">
      <div class="section-icon icon-accent">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><rect x="5" y="4" width="14" height="17" rx="2" stroke="#fff" stroke-width="2"/><path d="M9 3h6v3H9V3Z" fill="#fff"/></svg>
      </div>
      <h2>Orders to prepare</h2>
      <% if (pendingOrders.length > 0) { %><span class="action-count"><%= pendingOrders.length %></span><% } %>
    </div>
    <% if (pendingOrders.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none"><path d="m5 13 4 4L19 7" stroke="#1F7A54" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h3>Nothing pending</h3>
        <p>No pending orders.</p>
      </div>
    <% } else { %>
      <ul class="action-list">
        <% pendingOrders.forEach(l => { %>
          <li>
            <a href="/leads?sellerId=<%= currentSeller.id %>">
              <span>
                <span class="action-title"><%= l.quantity %>x <%= l.item %><% if (l.variant) { %> (<%= l.variant %>)<% } %></span><br />
                <span class="action-meta"><%= l.customerName %> &middot; <%= l.deliveryLocation %></span>
              </span>
              <span class="nowrap action-meta"><%= new Date(l.createdAt).toLocaleString() %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
